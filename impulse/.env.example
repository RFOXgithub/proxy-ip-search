# Login dasar saja, tanpa __cr...;city...;asn...
PROXY_USERNAME=your_dataimpulse_login
PROXY_PASSWORD=replace_with_new_password
PROXY_HOST=gw.dataimpulse.com
# combined = negara + kota opsional + ASN opsional
# location = negara + kota opsional; asn = negara + ASN opsional
PROXY_MODE=combined
COUNTRY=az
CITY=baku
# Kosong atau tidak disetel = tanpa filter ASN. Contoh: ASN=31721
ASN=
START_PORT=10000
END_PORT=20000
MAX_WORKERS=2
TARGET_IP_PREFIX=185.30.88.
IP_INFO_URL=https://ipinfo.io/json
EXECUTION_DURATION=200
REQUEST_TIMEOUT=5
BATCH_DELAY=0.25
