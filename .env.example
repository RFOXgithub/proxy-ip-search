# Runtime server (the persistent Python backend)
HOST=0.0.0.0
PORT=8765

# Use provider-prefixed names on the shared backend. Add other optional
# settings using the same prefixes (for example OXY_COUNTRY or ROYALE_CITY).
IMPULSE_PROXY_USERNAME=your_dataimpulse_username
IMPULSE_PROXY_PASSWORD=your_dataimpulse_password
OXY_PROXY_USERNAME=your_oxylabs_username
OXY_PROXY_PASSWORD=your_oxylabs_password
ROYALE_PROXY_USERNAME=your_iproyal_username
ROYALE_PROXY_PASSWORD=your_iproyal_password

# Vercel only: public HTTPS origin of the persistent backend, without a
# trailing slash (for example https://ipsearch-backend.example.com).
BACKEND_URL=https://your-persistent-python-backend.example.com
