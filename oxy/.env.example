# Username dasar, termasuk customer-; tanpa suffix sessid/cc.
PROXY_USERNAME=customer-your_username
PROXY_PASSWORD=replace_with_new_password
PROXY_HOST=pr.oxylabs.io
PROXY_PORT=7777
IP_INFO_URL=https://ipinfo.io/json
TARGET_IP_PREFIX=88.230.184.
SESSION_PREFIX=t01q
SESSION_MINUTES=30
START_SESSION=1
# Pilihan: asn atau location. Hanya parameter mode aktif yang dipakai.
PROXY_MODE=asn
ASN=9121
COUNTRY=tr
# Kosong = negara saja. Isi sakarya untuk negara + kota.
CITY=
MAX_WORKERS=25
REQUEST_TIMEOUT=5
EXECUTION_DURATION=200
# Jeda antar batch untuk mengurangi loop cepat ketika request gagal.
BATCH_DELAY=0.25
