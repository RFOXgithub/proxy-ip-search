# Username dan password DASAR IPRoyal; tanpa _country/_city/_session.
PROXY_USERNAME=your_iproyal_username
PROXY_PASSWORD=replace_with_new_password
PROXY_HOST=geo.iproyal.com
PROXY_PORT=32325
# socks5 = DNS lokal (sesuai kode lama); socks5h = DNS melalui proxy.
PROXY_SCHEME=socks5
COUNTRY=az
# Kosongkan untuk negara saja: CITY=
CITY=baku
# Prefix 0-4 karakter. Sisanya acak sehingga total ID tepat 8 karakter.
SESSION_PREFIX=m18m
SESSION_MINUTES=30
MAX_WORKERS=25
TARGET_IP_PREFIX=185.30.88.
IP_INFO_URL=https://ipinfo.io/json
EXECUTION_DURATION=200
REQUEST_TIMEOUT=5
BATCH_DELAY=0.25
